    <copies>1</copies>
    <GUI>
      <xloc>352</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Execute SQL script</name>
    <connection>BQ</connection>
    <sql>TRUNCATE TABLE ${BQ_DATASET}.raw_${TABLE_NAME}</sql>
    <execute_each_row>N</execute_each_row>
    <update_field/>
